    {
      "parameters": {
        "jsCode": "// Obtener el item completo\nconst item = $input.first().json;\n\n// Acceder a los rows correctamente (body.data.rows)\nconst rows = item.body?.data?.rows || [];\nif (rows.length === 0) {\n  throw new Error(\"No se encontraron rows en el payload\");\n}\n\nconst primerRow = rows[0];\nconst archivos = primerRow.archivo_pdf || [];\nif (archivos.length === 0) {\n  throw new Error(\"No se encontraron archivos adjuntos\");\n}\n\nconst signedPath = archivos[0].signedPath;\n\n// Construir la URL completa (usando host.docker.internal desde contenedores)\nconst pdfUrl = `http://nocodb:8080/${signedPath}`;\n\n// Devolver los datos necesarios para los siguientes nodos\nreturn [{\n  json: {\n    alumno_nombre: primerRow.nombre_alumno,\n    archivo_nombre: archivos[0].title,\n    pdf_url: pdfUrl,\n    // Incluir también el row completo por si acaso\n    ...primerRow\n  }\n}];"
      },
